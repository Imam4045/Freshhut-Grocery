# ================================================================
# FreshHut / Grocery Store - Git Ignore Rules
# ================================================================
# Keeps secrets, local environment files, generated data, editor
# settings, and temporary files out of the Git repository.

# ----------------------------------------------------------------
# Environment variables / local configuration
# ----------------------------------------------------------------
.env
.env.*
!.env.example

# Local-only PHP configuration / secrets
config/*-local.php
config/local.*
config/secrets.*
config/*secret*

# ----------------------------------------------------------------
# Database dumps / local database files
# ----------------------------------------------------------------
# Do not commit the current exported dump because it contains
# user records, password hashes, orders, and addresses. Keep deliberate
# schema/migration SQL files trackable in Git.
config/grocery_store.sql
*.sqlite
*.sqlite3
*.db

# ----------------------------------------------------------------
# Private keys / certificates
# ----------------------------------------------------------------
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks

# NOTE: config/ca.pem is intentionally NOT ignored because your
# application uses Aiven's CA certificate for the MySQL TLS connection.
# A CA certificate is not a database password or private key.

# ----------------------------------------------------------------
# Runtime logs / temporary files
# ----------------------------------------------------------------
*.log
logs/
log/
tmp/
temp/
cache/

# PHP / test / coverage artifacts
.phpunit.result.cache
.phpunit.cache/
coverage/

# ----------------------------------------------------------------
# Composer / PHP dependencies
# ----------------------------------------------------------------
vendor/
composer.phar

# ----------------------------------------------------------------
# Node / frontend tooling (safe even if added later)
# ----------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# Frontend build/cache output
.vite/
.parcel-cache/
.next/
out/
dist/
build/

# ----------------------------------------------------------------
# IDE / editor files
# ----------------------------------------------------------------
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace

# Vim / swap / backup files
*.swp
*.swo
*~
*.bak
*.backup
*.old

# ----------------------------------------------------------------
# Operating system files
# ----------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# ----------------------------------------------------------------
# Archives / local copies
# ----------------------------------------------------------------
*.zip
*.7z
*.tar
*.tar.gz
*.rar

# ----------------------------------------------------------------
# Deployment / platform-local files
# ----------------------------------------------------------------
.firebase/
.vercel/
.netlify/

# ----------------------------------------------------------------
# Keep useful project assets tracked
# ----------------------------------------------------------------
# uploads/products/ is NOT ignored because your product images are
# referenced by the database and are required by the website.
